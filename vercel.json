{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/studio.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "works"
        }
      ],
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "about"
        }
      ],
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "contact"
        }
      ],
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/all-works.html",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/all-works",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/case-study.html",
      "destination": "/chargeur",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/titaneyeplus_casestudy.html",
      "destination": "/titan-eyeplus",
      "permanent": true
    },
    {
      "source": "/titaneyeplus_casestudy",
      "destination": "/titan-eyeplus",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*).(bak|log|zip|docx)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*).(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|avif|gif|svg|mp4|mov|woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
